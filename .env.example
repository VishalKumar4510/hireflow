# Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hireflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hireflow
DB_USER=postgres
DB_PASSWORD=postgres

# AI Provider
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini

# JWT
JWT_SECRET=hireflow-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# Server
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:5173

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Demo Mode (set to true for hackathon demo)
DEMO_MODE=true
