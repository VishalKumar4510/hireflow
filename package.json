{
  "name": "hireflow",
  "version": "1.0.0",
  "private": true,
  "description": "HireFlow — AI Candidate Screening & Interview Intelligence Agent",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "migrate": "npm run migrate --prefix backend",
    "seed": "npm run seed --prefix backend",
    "setup": "npm install & npm install --prefix backend & npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
